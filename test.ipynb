import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
from scipy.optimize import curve_fit
from scipy.integrate import cumulative_trapezoid
from scipy.interpolate import interp1d

# -------------------------------
# Load experimental dataset
# -------------------------------
data_frame = pd.read_excel(
    r'Excel_processed\QP1400_SDB.xlsx', 
    header=[0,1,2], 
    index_col=0
)

# Refrence angle
strain_ref = data_frame['SDB_RD_2']['Calculation']['Y True strain'].dropna().values
stress_RD = data_frame['SDB_RD_2']['Calculation']['True stress'].dropna().values

## Swift
def swift_law(strain, C1, C2, C3):
    """Swift hardening law: σ = C1 * (ε + C2)^C3"""
    return C1 * (strain + C2) ** C3


popt_RD, _ = curve_fit(swift_law, strain_ref, stress_RD, p0=[1000, 0.01, 0.2], maxfev=50000)
C1_RD, C2_RD, C3_RD = popt_RD


#refrence valuyes
stress_fit_RD = swift_law(strain_ref, C1_RD, C2_RD, C3_RD)
W_RD = cumulative_trapezoid(strain_ref, stress_RD, initial=0)


# INverse unctino to get stress 

eps_RD_from_W = interp1d(
    W_RD, strain_ref, 
    bounds_error=False, fill_value="extrapolate"
)


strain_DD = data_frame['SDB_DD_2']['Calculation']['Y True strain'].dropna().values
stress_DD = data_frame['SDB_DD_2']['Calculation']['True stress'].dropna().values

W_DD = cumulative_trapezoid(strain_DD, stress_DD, initial=0)
eps_eq_DD = eps_RD_from_W(W_DD)        # Equivalent plastic strain







plt.figure(figsize=(10,6))
plt.plot(strain_ref, stress_RD, 'b-', label="RD ")
plt.plot(strain_DD, stress_DD, 'g--', label="DD")
plt.plot(eps_eq_DD, stress_DD, 'r-', label="DD work equiv")

plt.legend()
plt.grid(True)
plt.show()



